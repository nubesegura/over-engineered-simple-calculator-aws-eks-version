<mxfile host="app.diagrams.net" version="24.0.0"><diagram id="layers" name="Tiers"><mxGraphModel adaptiveColors="auto" dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="&lt;b&gt;Calculator, EKS version: tiers&lt;/b&gt;&lt;br&gt;Request path from the client to the data, and the platform around it" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="-60" width="900" height="50" as="geometry"/></mxCell>
