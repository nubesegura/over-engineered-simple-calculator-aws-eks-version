<mxCell id="browser" value="&lt;b&gt;Web page in the browser&lt;/b&gt;&lt;br&gt;calls the API with an ID token&lt;br&gt;(served by the webpage repository)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="laneClient"><mxGeometry x="80" y="50" width="190" height="70" as="geometry"/></mxCell>
<mxCell id="cognito" value="&lt;b&gt;Cognito user pool&lt;/b&gt;&lt;br&gt;login, ID token (JWT), JWKS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="laneClient"><mxGeometry x="300" y="50" width="190" height="70" as="geometry"/></mxCell>
<mxCell id="route53" value="&lt;b&gt;Route 53&lt;/b&gt;&lt;br&gt;weighted alias, one record per backend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#10739e;" vertex="1" parent="laneEdge"><mxGeometry x="80" y="50" width="190" height="70" as="geometry"/></mxCell>
