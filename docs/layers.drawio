<mxCell id="nat" value="&lt;b&gt;NAT gateway&lt;/b&gt;&lt;br&gt;outbound only, removed 22:00 to 08:00 in dev" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#10739e;" vertex="1" parent="laneEdge"><mxGeometry x="740" y="50" width="190" height="70" as="geometry"/></mxCell>
