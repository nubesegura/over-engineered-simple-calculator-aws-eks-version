<mxCell id="history" value="&lt;b&gt;History service&lt;/b&gt;&lt;br&gt;signed cursor, paging" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="laneCompute"><mxGeometry x="520" y="50" width="190" height="70" as="geometry"/></mxCell>
