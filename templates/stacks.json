{
  "description": "CloudFormation stacks of this repository in deploy order. Read by scripts/cfn_deploy.py and scripts/iac_owner_guard.py. Destroy runs the same list in reverse order. A unit with onlyIf is deployed only when the named parameter of parameters/<env>.json has that value.",
  "region": "us-east-2",
  "repository": "over-engineered-simple-calculator-aws-eks-version",
  "environments": {
    "dev": [
      {"unit": "security", "stack": "stk-useast2-oecalc-eks-security-dev", "template": "templates/security.yaml", "sam": false},
      {"unit": "network", "stack": "stk-useast2-oecalc-eks-network-dev", "template": "templates/network.yaml", "sam": false},
      {"unit": "registry", "stack": "stk-useast2-oecalc-eks-registry-dev", "template": "templates/registry.yaml", "sam": false},
      {"unit": "scheduler", "stack": "stk-useast2-oecalc-eks-scheduler-dev", "template": "templates/scheduler.yaml", "sam": true, "onlyIf": {"parameter": "NatSchedulerEnabled", "equals": "true"}},
      {"unit": "database", "stack": "stk-useast2-oecalc-eks-database-dev", "template": "templates/database.yaml", "sam": false},
      {"unit": "rotation", "stack": "stk-useast2-oecalc-eks-rotation-dev", "template": "templates/rotation.yaml", "sam": true},
      {"unit": "storage", "stack": "stk-useast2-oecalc-eks-storage-dev", "template": "templates/storage.yaml", "sam": false},
      {"unit": "cluster", "stack": "stk-useast2-oecalc-eks-cluster-dev", "template": "templates/cluster.yaml", "sam": false},
      {"unit": "deploy", "stack": "stk-useast2-oecalc-eks-deploy-dev", "template": "templates/deploy.yaml", "sam": false},
      {"unit": "bastion", "stack": "stk-useast2-oecalc-eks-bastion-dev", "template": "templates/bastion.yaml", "sam": false, "onlyIf": {"parameter": "EnableBastion", "equals": "true"}},
      {"unit": "alarms", "stack": "stk-useast2-oecalc-eks-alarms-dev", "template": "templates/alarms.yaml", "sam": false}
    ],
    "prod": [
      {"unit": "security", "stack": "stk-useast2-oecalc-eks-security-prod", "template": "templates/security.yaml", "sam": false},
      {"unit": "network", "stack": "stk-useast2-oecalc-eks-network-prod", "template": "templates/network.yaml", "sam": false},
      {"unit": "registry", "stack": "stk-useast2-oecalc-eks-registry-prod", "template": "templates/registry.yaml", "sam": false},
      {"unit": "scheduler", "stack": "stk-useast2-oecalc-eks-scheduler-prod", "template": "templates/scheduler.yaml", "sam": true, "onlyIf": {"parameter": "NatSchedulerEnabled", "equals": "true"}},
      {"unit": "database", "stack": "stk-useast2-oecalc-eks-database-prod", "template": "templates/database.yaml", "sam": false},
      {"unit": "rotation", "stack": "stk-useast2-oecalc-eks-rotation-prod", "template": "templates/rotation.yaml", "sam": true},
      {"unit": "storage", "stack": "stk-useast2-oecalc-eks-storage-prod", "template": "templates/storage.yaml", "sam": false},
      {"unit": "cluster", "stack": "stk-useast2-oecalc-eks-cluster-prod", "template": "templates/cluster.yaml", "sam": false},
      {"unit": "deploy", "stack": "stk-useast2-oecalc-eks-deploy-prod", "template": "templates/deploy.yaml", "sam": false},
      {"unit": "bastion", "stack": "stk-useast2-oecalc-eks-bastion-prod", "template": "templates/bastion.yaml", "sam": false, "onlyIf": {"parameter": "EnableBastion", "equals": "true"}},
      {"unit": "alarms", "stack": "stk-useast2-oecalc-eks-alarms-prod", "template": "templates/alarms.yaml", "sam": false}
    ]
  }
}
